PORT=3000
NODE_ENV=development

# PostgreSQL local ou hospedado. Use DATABASE_URL OU os campos DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dde_telecom
DB_USER=dde_user
DB_PASSWORD=

# Gere um segredo aleatório de pelo menos 32 caracteres. Não reutilize segredos distribuídos.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origem exata HTTPS do site em produção (incluindo domínio próprio).
# No Render, a origem padrão também é obtida de RENDER_EXTERNAL_URL.
FRONTEND_URL=

# Conexão direta, somente para pré-validação/migração manual. Nunca vai para o navegador.
DATABASE_URL_UNPOOLED=
