PORT=3000
NODE_ENV=development

# PostgreSQL local ou hospedado. Use DATABASE_URL OU os campos DB_*.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Gere um valor aleatório forte. Nunca use o texto de exemplo em produção.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# URL pública do site, necessária apenas se front e API estiverem em domínios diferentes.
FRONTEND_URL=

# ID público do conjunto de dados Web (Meta Pixel). Vazio desativa a medição.
META_PIXEL_ID=

# Meta Lead Ads (Facebook/Instagram). Mantenha os segredos vazios neste exemplo.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# Defina a versão ativa do Graph API na configuração da aplicação Meta (ex.: vXX.X).
META_GRAPH_API_VERSION=
# ID da Página autorizada; obrigatório para rejeitar eventos de outras Páginas.
META_PAGE_ID=
# Avisos internos por WhatsApp: deixar desligado até concluir o teste real.
WHATSAPP_NOTIFICATIONS_MODE=off
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCOUNT_ID=
WHATSAPP_RECIPIENT=5534996440163
WHATSAPP_RECIPIENTS=5534996440163,5534996557353
WHATSAPP_TEMPLATE_NAME=dde_novo_lead_v1
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_SETUP_TEST_ID=
WHATSAPP_MAX_MESSAGES_PER_MONTH=100
WHATSAPP_RATE_VALID_UNTIL=2026-12-31

# Avisos por e-mail: retransmissor Google da própria DDE, com assinatura privada.
EMAIL_NOTIFICATIONS_MODE=off
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
EMAIL_RECIPIENT=ddetelecom@gmail.com
EMAIL_SETUP_TEST_ID=
